# n8n <-> host Postgres (native, not Docker)
POSTGRES_DB=n8n
POSTGRES_USER=n8n
POSTGRES_PASSWORD=change-me

# n8n
N8N_ENCRYPTION_KEY=generate-with-openssl-rand-hex-32
N8N_HOST=workers.themobileprof.com
N8N_PROTOCOL=https
N8N_WEBHOOK_URL=https://workers.themobileprof.com/
GENERIC_TIMEZONE=Africa/Lagos
N8N_LICENSE_ACTIVATION_KEY=

# Go workers — swap providers without code changes.
# Text chat uses LLM_PROVIDER (deepseek | openai | anthropic | gemini).
# Provider-specific labels work: DEEPSEEK_API_KEY / GEMINI_API_KEY (LLM_API_KEY still accepted).
# Receipt photos are OCR'd with Gemini when GEMINI_API_KEY is set (gemini-3.6-flash; vision).
LLM_PROVIDER=deepseek
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Optional text fallbacks — tried if the primary provider errors (desk Help? bot and workers).
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Company desk (separate Postgres from n8n). Create with scripts/bootstrap-admin-db.sh
ADMIN_DATABASE_URL=postgres://aiworkers:change-me@host.docker.internal:5432/aiworkers?sslmode=disable
ADMIN_BOOTSTRAP_NAME=Samuel
ADMIN_BOOTSTRAP_PHONE=2348033954301
ADMIN_BOOTSTRAP_EMAIL=info@themobileprof.com
ADMIN_BOOTSTRAP_PASSWORD=change-me
ADMIN_COOKIE_SECURE=true
INTERNAL_API_TOKEN=generate-with-openssl-rand-hex-32

# Google PageSpeed Insights (optional, free quota). Measures a URL you name. Not keyword spy.
PAGESPEED_API_KEY=

# Paystack (n8n only — never the Go worker). Start with sk_test_… until you go live.
PAYSTACK_SECRET_KEY=

# Google Ads (n8n only — never the Go worker). API Center developer token. OAuth stays in n8n credential Google Ads.
GOOGLE_ADS_DEVELOPER_TOKEN=

# Fathom (n8n only — never the Go worker). Webhook https://workers.themobileprof.com/webhook/pm-notes
FATHOM_API_KEY=
FATHOM_WEBHOOK_SECRET=

# Ops Telegram (Go inbound). Token from BotFather / n8n "Telegram account". Secret must match setWebhook.
TELEGRAM_OPS_BOT_TOKEN=
TELEGRAM_OPS_WEBHOOK_SECRET=
TELEGRAM_OPS_WEBHOOK_URL=https://workers.themobileprof.com/webhook/telegram-ops/webhook

# Academy Telegram (Go inbound). Same token as n8n credential "Telegram Academy" (weekly intro send).
TELEGRAM_ACADEMY_BOT_TOKEN=
TELEGRAM_ACADEMY_WEBHOOK_SECRET=
TELEGRAM_ACADEMY_WEBHOOK_URL=https://workers.themobileprof.com/webhook/telegram-academy/webhook

# LMS catalog + paid lesson bodies (admin login). Password stays on the VM — never git.
LMS_API_BASE=https://api.themobileprof.com
LMS_EMAIL=
LMS_PASSWORD=

# Daily student airtime (Go). Amount in naira. Never git the key.
CLUBKONNECT_USERID=
CLUBKONNECT_APIKEY=
REWARD_AMOUNT=500
JOIN_ORIGIN=https://lms.themobileprof.com
JOIN_SYNC_SECRET=

# Agents → n8n on the Docker network (Books write, email outbox, ads Place). Not a public URL.
N8N_BASE_URL=http://n8n:5678
