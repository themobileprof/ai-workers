# n8n <-> host Postgres (native, not Docker)
POSTGRES_DB=n8n
POSTGRES_USER=n8n
POSTGRES_PASSWORD=change-me

# n8n
N8N_ENCRYPTION_KEY=generate-with-openssl-rand-hex-32
N8N_HOST=workers.themobileprof.com
N8N_PROTOCOL=https
N8N_WEBHOOK_URL=https://workers.themobileprof.com/
GENERIC_TIMEZONE=Africa/Lagos
N8N_LICENSE_ACTIVATION_KEY=

# Go workers — swap providers without code changes
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat
LLM_API_KEY=
# Optional override (DeepSeek default is https://api.deepseek.com/v1)
LLM_BASE_URL=https://api.deepseek.com

# Company desk (separate Postgres from n8n). Create with scripts/bootstrap-admin-db.sh
ADMIN_DATABASE_URL=postgres://aiworkers:change-me@host.docker.internal:5432/aiworkers?sslmode=disable
ADMIN_BOOTSTRAP_NAME=Samuel
ADMIN_BOOTSTRAP_PHONE=2348033954301
ADMIN_BOOTSTRAP_EMAIL=info@themobileprof.com
ADMIN_BOOTSTRAP_PASSWORD=change-me
ADMIN_COOKIE_SECURE=true
INTERNAL_API_TOKEN=generate-with-openssl-rand-hex-32
