      "parameters": {
        "jsCode": "function flattenSearch(res) {\n  if (Array.isArray(res)) return res.flatMap((chunk) => chunk.results || []);\n  if (res && Array.isArray(res.results)) return res.results;\n  return [];\n}\nfunction num(v) { const n = Number(v); return Number.isFinite(n) ? n : 0; }\nconst p = $('Each placement').item.json;\nconst idle = { skip: true, channel: 'google', id: p.id, customer_id: p.customer_id, login_customer_id: p.login_customer_id, note: '', dropped: p.dropped || [] };\nconst metrics = flattenSearch($('GET Google metrics').item.json || {});\nconst schedRows = flattenSearch($input.first().json || {});\nif (!metrics.length) return [{ json: idle }];\nconst camp = metrics[0].campaign || {};\nif (String(camp.status || '').toUpperCase() === 'PAUSED') return [{ json: idle }];\nconst campaignResource = String(camp.resourceName || camp.resource_name || '');\nconst rows = [];\nfor (const row of metrics) {\n  const ag = row.adGroup || row.ad_group || {};\n  const key = String(ag.resourceName || ag.resource_name || '');\n  if (!key) continue;\n  const seg = row.segments || {};\n  const m = row.metrics || {};\n  rows.push({\n    key,\n    name: String(ag.name || ''),\n    hour: num(seg.hour),\n    day_of_week: String(seg.dayOfWeek || seg.day_of_week || ''),\n    cost: num(m.costMicros || m.cost_micros) / 1e6,\n    clicks: num(m.clicks),\n    conversions: num(m.conversions),\n    impressions: num(m.impressions)\n  });\n}\nconst schedules = [];\nfor (const row of schedRows) {\n  const c = row.campaignCriterion || row.campaign_criterion || {};\n  const ad = c.adSchedule || c.ad_schedule || {};\n  const rn = String(c.resourceName || c.resource_name || '');\n  if (!rn) continue;\n  schedules.push({\n    resource_name: rn,\n    day_of_week: String(ad.dayOfWeek || ad.day_of_week || ''),\n    start_hour: num(ad.startHour || ad.start_hour),\n    end_hour: num(ad.endHour || ad.end_hour)\n  });\n}\nreturn [{ json: {\n  skip: false,\n  channel: 'google',\n  id: p.id,\n  customer_id: p.customer_id,\n  login_customer_id: p.login_customer_id,\n  campaign_id: p.campaign_id,\n  campaign_resource: campaignResource,\n  age_days: p.age_days,\n  dropped: p.dropped || [],\n  rows,\n  schedules\n} }];\n"
      },
