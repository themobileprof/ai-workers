      "parameters": {
        "jsCode": "function tooNew(days) {\n  const n = Number(days);\n  return Number.isFinite(n) && n < 7;\n}\nconst body = $input.first().json || {};\nconst googleCustomer = String(body.google_customer_id || '').replace(/\\D/g, '');\nconst googleLogin = String(body.google_login_customer_id || '').replace(/\\D/g, '') || googleCustomer;\nconst list = Array.isArray(body.placements) ? body.placements : [];\nconst rows = [];\nfor (const pl of list) {\n  const channel = String(pl.channel || '').toLowerCase();\n  const campaignId = String(pl.campaign_id || '').replace(/\\D/g, '');\n  if (!campaignId || tooNew(pl.age_days)) continue;\n  const customerId = String(pl.customer_id || '').replace(/\\D/g, '') || googleCustomer;\n  rows.push({ json: {\n    skip: false,\n    channel,\n    deck_id: pl.deck_id,\n    id: String(pl.id || ''),\n    campaign_id: campaignId,\n    customer_id: customerId,\n    login_customer_id: googleLogin,\n    age_days: Number(pl.age_days) || 0,\n    dropped: Array.isArray(pl.dropped) ? pl.dropped : [],\n    metrics_query: \"SELECT ad_group.id, ad_group.resource_name, ad_group.name, ad_group.status, campaign.resource_name, campaign.status, segments.hour, segments.day_of_week, metrics.impressions, metrics.clicks, metrics.conversions, metrics.cost_micros FROM ad_group WHERE campaign.id = \" + campaignId + \" AND ad_group.status = 'ENABLED' AND segments.date DURING LAST_7_DAYS\",\n    schedule_query: \"SELECT campaign_criterion.resource_name, campaign.resource_name, campaign_criterion.ad_schedule.day_of_week, campaign_criterion.ad_schedule.start_hour, campaign_criterion.ad_schedule.end_hour FROM campaign_criterion WHERE campaign.id = \" + campaignId + \" AND campaign_criterion.type = 'AD_SCHEDULE' AND campaign_criterion.status != 'REMOVED'\"\n  } });\n}\nreturn rows.length ? rows : [{ json: { skip: true } }];\n"
