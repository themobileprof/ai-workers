    {
      "parameters": {
        "jsCode": "function num(v) { const n = Number(v); return Number.isFinite(n) ? n : 0; }\nfunction conversions(row) {\n  let n = 0;\n  for (const a of (row.actions || [])) {\n    const t = String(a.action_type || '');\n    if (t.includes('purchase') || t === 'lead' || t.includes('complete_registration')) n += num(a.value);\n  }\n  return n;\n}\nfunction hourFrom(row) {\n  const raw = row.hourly_stats_aggregated_by_advertiser_time_zone || row.hourly_stats_aggregated_by_audience_time_zone || '';\n  const m = String(raw).match(/(\\d{1,2})/);\n  if (!m) return null;\n  const h = Number(m[1]);\n  return Number.isFinite(h) ? h : null;\n}\nfunction listOf(raw) {\n  if (Array.isArray(raw.data)) return raw.data;\n  if (Array.isArray(raw)) return raw;\n  return [];\n}\nconst p = $('Each placement').item.json;\nconst idle = { skip: true, channel: 'meta', id: p.id, note: '', dropped: p.dropped || [] };\nconst dailyRaw = $('GET Meta daily').item.json || {};\nconst hourlyRaw = $input.first().json || {};\nif (dailyRaw.error && hourlyRaw.error) return [{ json: idle }];\nconst rows = [];\nfor (const row of listOf(dailyRaw)) {\n  const id = String(row.adset_id || '');\n  if (!id) continue;\n  rows.push({\n    key: id,\n    name: String(row.adset_name || id),\n    date: String(row.date_start || row.date || ''),\n    cost: num(row.spend),\n    clicks: num(row.clicks),\n    conversions: conversions(row),\n    impressions: num(row.impressions)\n  });\n}\nfor (const row of listOf(hourlyRaw)) {\n  const id = String(row.adset_id || '');\n  const h = hourFrom(row);\n  if (!id || h === null) continue;\n  rows.push({\n    key: id,\n    name: String(row.adset_name || id),\n    hour: h,\n    cost: num(row.spend),\n    clicks: num(row.clicks),\n    conversions: conversions(row),\n    impressions: num(row.impressions)\n  });\n}\nif (!rows.length) return [{ json: idle }];\nreturn [{ json: {\n  skip: false,\n  channel: 'meta',\n  id: p.id,\n  age_days: p.age_days,\n  dropped: p.dropped || [],\n  rows\n} }];\n"
      },
