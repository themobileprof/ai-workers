{
  "id": "crmDueDaily00001",
  "name": "CRM due today",
  "active": true,
  "isArchived": false,
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "daysInterval": 1,
              "triggerAtHour": 9,
              "triggerAtMinute": 0
            }
          ]
        }
      },
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "id": "crmDueDailyTrig0001",
      "name": "09:00 Lagos"
    },
    {
      "parameters": {
        "method": "GET",
        "url": "http://agents:8000/internal/v1/crm/due",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Internal-Token",
              "value": "={{ $env.INTERNAL_API_TOKEN }}"
            }
          ]
        },
        "options": {
          "timeout": 8000
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        240,
        0
      ],
      "id": "crmDueDailyFetch001",
      "name": "Fetch due",
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json || {};\nconst list = Array.isArray(raw.people) ? raw.people : [];\nconst items = [];\nfor (const p of list) {\n  if (!p || !p.speak) continue;\n  const chatId = String(p.telegram_id || '').replace(/\\D/g, '');\n  const text = String(p.text || '').trim();\n  if (!chatId || !text) continue;\n  items.push({\n    json: {\n      chat_id: chatId,\n      text: text.length > 4000 ? text.slice(0, 3990) + '…' : text\n    }\n  });\n}\nreturn items;\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        0
      ],
      "id": "crmDueDailyPrep0001",
      "name": "Prepare pings"
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "={{ $json.chat_id }}",
        "text": "={{ $json.text }}",
        "additionalFields": {
          "appendAttribution": false
        }
      },
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        720,
        0
      ],
      "id": "crmDueDailySend0001",
      "name": "Send Telegram",
      "credentials": {
        "telegramApi": {
          "id": "GD7WqGif3v6QlSbc",
          "name": "Telegram account"
        }
      }
    }
  ],
  "connections": {
    "09:00 Lagos": {
      "main": [
        [
          {
