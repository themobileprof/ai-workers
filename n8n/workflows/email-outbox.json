      "name": "Notify ops",
      "credentials": {
        "telegramApi": {
          "id": "GD7WqGif3v6QlSbc",
          "name": "Telegram account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const s = $getWorkflowStaticData('global');\nconst pending = s.pending;\nif (!pending || !pending.to || !pending.text) {\n  return [{ json: { empty: true, text: 'No pending email draft.' } }];\n}\nreturn [{ json: { empty: false, to: pending.to, subject: pending.subject, text: pending.text } }];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        520,
        40
      ],
      "id": "e0f1a2b3-c4d5-4e6f-a7b8-outboxload0001",
