    {
      "parameters": {
        "jsCode": "const s = $getWorkflowStaticData('global');\nconst j = $input.first().json;\nconst pending = {\n  to: String(j.to || '').trim(),\n  subject: String(j.subject || 'Re: (no subject)').trim(),\n  text: String(j.text || '').trim(),\n  from_original: String(j.from_original || j.to || '').trim(),\n  subject_original: String(j.subject_original || '').trim()\n};\ns.pending = pending;\nif (j.chat_id) s.ops_chat_id = String(j.chat_id);\nconst chat_id = String(s.ops_chat_id || '');\nlet body = [\n  'Draft reply for info@',\n  'From: ' + pending.from_original,\n  'Subject: ' + pending.subject_original,\n  '',\n  pending.text,\n  '',\n  '/approve to send. /kill to drop. One pending draft at a time.'\n].join('\\n');\nif (body.length > 4000) body = body.slice(0, 3990) + '\u2026';\nreturn [{ json: { chat_id, text: body, has_chat: Boolean(chat_id) } }];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        520,
        -200
      ],
      "id": "e0f1a2b3-c4d5-4e6f-a7b8-outboxstore001",
      "name": "Store draft"
    },
