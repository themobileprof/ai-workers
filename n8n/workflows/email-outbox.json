        "smtp": {
          "id": "cvlEAE8BvvQ87wew",
          "name": "Zoho Mail info@"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const s = $getWorkflowStaticData('global');\nconst pending = s.pending || {};\ns.pending = null;\nreturn [{ json: { sent: true, to: pending.to, text: 'Sent to ' + (pending.to || 'the sender') + '.' } }];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1240,
        160
      ],
      "id": "e0f1a2b3-c4d5-4e6f-a7b8-outboxclear001",
      "name": "Clear pending"
    },
    {
      "parameters": {
        "jsCode": "const s = $getWorkflowStaticData('global');\nconst had = Boolean(s.pending && s.pending.to);\ns.pending = null;\nreturn [{ json: { killed: had, empty: !had, text: had ? 'Dropped the pending draft.' : 'No pending email draft.' } }];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        520,
        240
