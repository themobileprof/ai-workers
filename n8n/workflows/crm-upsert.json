        "url": "https://www.zohoapis.com/books/v3/contacts",
        "sendQuery": true,
        "specifyQuery": "json",
        "jsonQuery": "={{ JSON.stringify(Object.assign({ organization_id: '939049468', per_page: 5 }, $json.email ? { email: $json.email } : ($json.phone ? { phone: $json.phone } : { contact_name: $json.contact_name }))) }}",
        "options": {
