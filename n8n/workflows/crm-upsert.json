      "name": "Search contacts",
      "onError": "continueRegularOutput",
      "credentials": {
        "oAuth2Api": {
          "id": "ByEtw1MmiDqYxQWI",
          "name": "Zoho Books"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const incoming = $('Normalize contact').item.json;\nconst res = $input.first().json || {};\nconst list = Array.isArray(res.contacts) ? res.contacts : [];\nlet hit = list[0];\nif (incoming.email) {\n  hit = list.find((c) => String(c.email || '').toLowerCase() === incoming.email) || hit;\n}\nif (hit && hit.contact_id) {\n  const prev = String(hit.notes || '').trim();\n  const notes = [prev, incoming.notes].filter(Boolean).join('\\n').slice(0, 2000);\n  return [{ json: { mode: 'update', contact_id: String(hit.contact_id), contact_name: incoming.contact_name, company_name: incoming.company_name, email: incoming.email, phone: incoming.phone, notes } }];\n}\nconst body = {\n  contact_name: incoming.contact_name,\n  contact_type: 'customer',\n  notes: incoming.notes\n};\nif (incoming.company_name) body.company_name = incoming.company_name;\nif (incoming.email || incoming.phone) {\n  const person = { first_name: incoming.contact_name.split(/\\s+/)[0] || incoming.contact_name, is_primary_contact: true };\n  if (incoming.email) person.email = incoming.email;\n  if (incoming.phone) person.phone = incoming.phone;\n  body.contact_persons = [person];\n  if (incoming.email) body.email = incoming.email;\n  if (incoming.phone) body.phone = incoming.phone;\n}\nreturn [{ json: { mode: 'create', body } }];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
