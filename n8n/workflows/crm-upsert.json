    {
      "parameters": {
        "jsCode": "const j = $input.first().json || {};\nlet email = String(j.email || '').trim().toLowerCase();\nif (email && !email.includes('@')) email = '';\nlet phone = String(j.phone || '').replace(/[^\\d+]/g, '');\nlet name = String(j.contact_name || j.name || '').trim();\nif (!name) {\n  if (email) name = email.split('@')[0];\n  else if (phone) name = 'WhatsApp ' + phone;\n}\nif (!name) {\n  return [{ json: { skip: true, text: 'No contact to save.' } }];\n}\nconst notes = ['CRM', j.pipeline_stage, j.next_action, j.notes, j.source].filter(Boolean).join(' | ').slice(0, 500);\nreturn [{\n  json: {\n    skip: false,\n    contact_name: name.slice(0, 200),\n    company_name: String(j.company_name || '').trim().slice(0, 200),\n    email,\n    phone,\n    notes,\n    pipeline_stage: String(j.pipeline_stage || 'new')\n  }\n}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ],
      "id": "c1a2b3d4-e5f6-7890-crm1norm00001",
      "name": "Normalize contact"
    },
