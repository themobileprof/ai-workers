    {
      "parameters": {
        "jsCode": "const r = $input.first().json || {};\nconst prep = $('Prepare task').item.json;\nconst chat_id = String(prep.chat_id || (prep.context_data && prep.context_data.chat_id) || '');\nlet text = String(r.text || '').trim();\nif (r.sent) text = 'Sent to ' + (r.to || 'the sender') + '.';\nelse if (r.killed) text = 'Dropped the pending draft.';\nelse if (r.empty) text = 'No pending email draft.';\nif (!text) text = 'No pending email draft.';\nreturn [{ json: { chat_id, text } }];\n"
      },
