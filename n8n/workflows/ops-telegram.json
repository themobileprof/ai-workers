    {
      "parameters": {
        "jsCode": "\nconst worker = $('Call department').item.json;\nconst prep = $('Prepare task').item.json;\nconst sd = worker.structured_data || {};\nconst task = String(sd.task_type || '').toLowerCase();\nconst accountsDept = prep.department === 'internal-ops' || prep.department === 'accounts';\nlet action = String(sd.zoho_action || '').toLowerCase();\nconst allowed = ['expense', 'bill', 'invoice', 'lookup', 'preview'];\nif (!allowed.includes(action) && (sd.record_expense === true || sd.record_expense === 'true')) {\n  action = 'expense';\n}\nconst record_zoho = accountsDept\n  && worker.status === 'success'\n  && task === 'accounts'\n  && allowed.includes(action);\n\nreturn [{ json: {\n  ...worker,\n  ...sd,\n  record_zoho,\n  action: record_zoho ? action : 'none',\n  amount: sd.amount,\n  vendor_name: sd.vendor_name || sd.vendor || '',\n  customer_name: sd.customer_name || '',\n  date: sd.date,\n  description: String(sd.notes || prep.task_description || '').slice(0, 200),\n  zoho_account_name: sd.zoho_account_name,\n  is_taxable_service: sd.is_taxable_service === true,\n  is_professional_service: sd.is_professional_service === true,\n  reference: sd.reference || sd.reference_number || '',\n  lookup: sd.lookup || 'overview',\n  currency: sd.currency || 'NGN'\n} }];\n"
