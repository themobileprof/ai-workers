    {
      "parameters": {
        "jsCode": "const worker = $('Call department').item.json;\nconst prep = $('Prepare task').item.json;\nconst sd = worker.structured_data || {};\nconst ctx = prep.context_data || {};\nconst task = String(sd.task_type || '').toLowerCase();\nconst intent = Number(sd.intent_score);\nconst recordFlag = sd.record_lead === true || sd.record_lead === 'true';\nconst record_crm = worker.status === 'success' && (\n  prep.department === 'crm' ||\n  recordFlag ||\n  (Number.isFinite(intent) && intent >= 0.6)\n);\nlet phone = String(sd.phone || '').trim();\nif (!phone && ctx.channel === 'whatsapp' && ctx.from && /^\\d{8,}$/.test(String(ctx.from))) {\n  phone = String(ctx.from);\n}\nlet email = String(sd.email || '').trim();\nif (!email && ctx.channel === 'email' && ctx.from && String(ctx.from).includes('@')) {\n  email = String(ctx.from);\n}\nlet contact_name = String(sd.contact_name || sd.name || '').trim();\nif (!contact_name && ctx.username) contact_name = String(ctx.username);\nconst crm_contact = record_crm ? {\n  contact_name,\n  company_name: String(sd.company_name || '').trim(),\n  email,\n  phone,\n  pipeline_stage: String(sd.pipeline_stage || 'new'),\n  next_action: String(sd.next_action || '').trim(),\n  notes: String(sd.notes || '').trim(),\n  source: ctx.channel || 'ops',\n  task_type: task\n} : null;\nreturn [{ json: { ...worker, record_crm, crm_contact } }];\n"
      },
