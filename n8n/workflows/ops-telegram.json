    {
      "parameters": {
        "jsCode": "const event = $input.first().json;\nconst msg = event.message || {};\nconst fromUser = msg.from || {};\nif (fromUser.is_bot) {\n  return [];\n}\nlet text = msg.text ? String(msg.text).trim() : '';\nif (!text) {\n  return [];\n}\nconst chat = msg.chat || {};\nconst chatId = String(chat.id || '');\nconst chatKind = (chat.type === 'group' || chat.type === 'supergroup') ? 'group' : 'dm';\nif (/^\\/approve(?:@\\w+)?\\b/i.test(text)) {\n  return [{ json: { skip_llm: true, ops_action: 'approve', chat_id: chatId, text: '' } }];\n}\nif (/^\\/kill(?:@\\w+)?\\b/i.test(text)) {\n  return [{ json: { skip_llm: true, ops_action: 'kill', chat_id: chatId, text: '' } }];\n}\nif (/^\\/(start|help)(?:@\\w+)?\\b/i.test(text)) {\n  return [{\n    json: {\n      skip_llm: true,\n      chat_id: chatId,\n      text: [\n        'Ops bot. Prefix a message:',\n        '/growth \u2014 sales and support',\n        '/crm \u2014 qualify or update a lead',\n        '/cm or /community \u2014 community manager',\n        '/accounts \u2014 Books: paid expense, vendor bill, invoice (Paystack link if email), or lookup',\n        '/ops \u2014 accounts, legal, grants (real expenses post to Zoho)',\n        '/validate \u2014 product validation',\n        '/approve \u2014 send the pending info@ draft',\n        '/kill \u2014 drop the pending draft',\n        'No prefix: 1:1 uses growth, groups use community.'\n      ].join('\\n')\n    }\n  }];\n}\nlet department = chatKind === 'group' ? 'community' : 'growth';\nconst commands = [\n  { re: /^(?:\\/community|\\/cm)(?:@\\w+)?\\b\\s*/i, dest: 'community' },\n  { re: /^\\/accounts(?:@\\w+)?\\b\\s*/i, dest: 'accounts' },\n  { re: /^\\/ops(?:@\\w+)?\\b\\s*/i, dest: 'internal-ops' },\n  { re: /^\\/validate(?:@\\w+)?\\b\\s*/i, dest: 'product-dev' },\n  { re: /^\\/growth(?:@\\w+)?\\b\\s*/i, dest: 'growth' },\n  { re: /^\\/crm(?:@\\w+)?\\b\\s*/i, dest: 'crm' }\n];\nfor (const cmd of commands) {\n  if (cmd.re.test(text)) {\n    department = cmd.dest;\n    text = text.replace(cmd.re, '').trim();\n    break;\n  }\n}\nif (!text) {\n  text = department === 'community'\n    ? 'Welcome this person and ask how you can help in the community.'\n    : 'Greet the person and ask how you can help.';\n}\nreturn [{\n  json: {\n    skip_llm: false,\n    department,\n    task_description: text,\n    context_data: {\n      channel: 'telegram',\n      chat_kind: chatKind,\n      department,\n      chat_id: chatId,\n      from: String(fromUser.id || ''),\n      username: fromUser.username || ''\n    }\n  }\n}];"
      },
