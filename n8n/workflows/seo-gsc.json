      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [1100, -80],
      "id": "seoGscDailyPg00001",
      "name": "Pages",
      "credentials": {
        "googleApi": {
          "id": "googleAnalyticsSA001",
          "name": "Google Analytics"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "function googleErr(raw) {\n  if (!raw || typeof raw !== 'object') return true;\n  if (raw.error || raw.error_code) return true;\n  if (raw.message && !raw.rows && raw.rows !== undefined) return false;\n  if (raw.message && !Array.isArray(raw.rows) && !raw.responseAggregationType) return true;\n  return false;\n}\nfunction rowsOf(raw, key) {\n  const out = [];\n  for (const row of (raw.rows || []).slice(0, 15)) {\n    const keys = row.keys || [];\n    const name = String(keys[0] || '').trim();\n    if (!name) continue;\n    const item = { clicks: Number(row.clicks) || 0, impressions: Number(row.impressions) || 0, ctr: Number(row.ctr) || 0, position: Number(row.position) || 0 };\n    item[key] = name;\n    out.push(item);\n  }\n  return out;\n}\nconst site = $('Site url').first().json || {};\nconst totalsRaw = $('Totals').first().json || {};\nconst queriesRaw = $('Queries').first().json || {};\nconst pagesRaw = $('Pages').first().json || {};\nif (googleErr(totalsRaw) || googleErr(queriesRaw) || googleErr(pagesRaw)) {\n  return [];\n}\nconst tot = (totalsRaw.rows && totalsRaw.rows[0]) || {};\nreturn [{ json: {\n  source: 'gsc_searchanalytics',\n  site_url: String(site.site_url || ''),\n  range: String(site.start_date || '') + ':' + String(site.end_date || ''),\n  fetched_at: new Date().toISOString(),\n  clicks: Number(tot.clicks) || 0,\n  impressions: Number(tot.impressions) || 0,\n  ctr: Number(tot.ctr) || 0,\n  position: Number(tot.position) || 0,\n  queries: rowsOf(queriesRaw, 'query'),\n  pages: rowsOf(pagesRaw, 'url')\n} }];\n"
      },
