    {
      "parameters": {
        "jsCode": "function ymd(d) {\n  return d.toISOString().slice(0, 10);\n}\nconst settings = $input.first().json || {};\nlet site = String(settings['seo.gsc_site_url'] || '').trim();\nif (!site) {\n  return [];\n}\nif (/^sc-domain:/i.test(site)) {\n  site = 'sc-domain:' + site.slice('sc-domain:'.length).trim().toLowerCase();\n} else if (!site.endsWith('/')) {\n  site += '/';\n}\nconst end = new Date();\nend.setUTCDate(end.getUTCDate() - 3);\nconst start = new Date(end);\nstart.setUTCDate(start.getUTCDate() - 27);\nreturn [{ json: { site_url: site, start_date: ymd(start), end_date: ymd(end) } }];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [440, 0],
      "id": "seoGscDailySite001",
      "name": "Site url"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ 'https://searchconsole.googleapis.com/webmasters/v3/sites/' + encodeURIComponent($json.site_url) + '/searchAnalytics/query' }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ startDate: $json.start_date, endDate: $json.end_date, dataState: 'final' }) }}",
