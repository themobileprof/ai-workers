{
  "id": "commWeeklyPing01",
  "name": "Community weekly intro",
  "active": true,
  "isArchived": false,
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "weeks",
              "weeksInterval": 1,
              "triggerAtDay": [1],
              "triggerAtHour": 9,
              "triggerAtMinute": 0
            }
          ]
        }
      },
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0],
      "id": "commWeekly000000trig01",
      "name": "Monday 09:00 Lagos"
    },
    {
      "parameters": {
        "method": "GET",
        "url": "http://agents:8000/internal/v1/community/mandates",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Internal-Token",
              "value": "={{ $env.INTERNAL_API_TOKEN }}"
            }
          ]
        },
        "options": {
          "timeout": 5000
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [240, 0],
      "id": "commWeekly000000fetch1",
      "name": "Fetch mandates",
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const PHONE_NUMBER_ID = '1353516234507857';\nconst raw = $input.first().json || {};\nconst list = Array.isArray(raw.mandates) ? raw.mandates : [];\nreturn list\n  .filter((m) => m && m.active !== false && String(m.whatsapp_group_id || '').trim())\n  .map((m) => ({\n    json: {\n      department: 'community',\n      task_description: 'Weekly check-in. Introduce yourself as the room host. Explain how people call you in this WhatsApp group (unprefixed chat already reaches you; /cm or /community to be sure). Then ask what course title and lesson each person is on this week, and one thing they learned. Keep it phone-short. No sales pitch.',\n      context_data: {\n        channel: 'whatsapp',\n        chat_kind: 'group',\n        department: 'community',\n        action: 'weekly_intro',\n        group_id: String(m.whatsapp_group_id).trim(),\n        mandate: m,\n        phone_number_id: PHONE_NUMBER_ID\n      }\n    }\n  }));\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [480, 0],
      "id": "commWeekly000000prep01",
      "name": "Prepare weekly"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ 'http://agents:8000/departments/' + $json.department }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Internal-Token",
              "value": "={{ $env.INTERNAL_API_TOKEN }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ task_description: $json.task_description, context_data: $json.context_data }) }}",
        "options": {
          "timeout": 120000
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [720, 0],
      "id": "commWeekly000000call01",
      "name": "Call community"
    },
    {
      "parameters": {
        "jsCode": "const worker = $input.first().json || {};\nconst prep = $('Prepare weekly').item.json;\nconst sd = worker.structured_data || {};\nconst text = String(worker.output_text || '').replace(/^#{1,6}\\s+/gm, '').replace(/\\*\\*/g, '').replace(/\\*/g, '').trim();\nif (sd.speak === false || sd.speak === 'false' || !text) {\n  return [];\n}\nreturn [{\n  json: {\n    text: text.length > 4000 ? text.slice(0, 3990) + '\\u2026' : text,\n    to: prep.context_data.group_id,\n    phoneNumberId: prep.context_data.phone_number_id\n  }\n}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [960, 0],
      "id": "commWeekly000000fmt001",
      "name": "Format intro"
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "send",
        "phoneNumberId": "={{ $json.phoneNumberId }}",
        "recipientPhoneNumber": "={{ $json.to }}",
        "messageType": "text",
        "textBody": "={{ $json.text }}",
        "additionalFields": {}
      },
      "type": "n8n-nodes-base.whatsApp",
      "typeVersion": 1.1,
      "position": [1200, 0],
      "id": "commWeekly000000send1",
      "name": "Send WhatsApp",
      "credentials": {
        "whatsAppApi": {
          "id": "TpVfkoyKY6eZDl87",
          "name": "WhatsApp account"
        }
      }
    }
  ],
  "connections": {
    "Monday 09:00 Lagos": {
      "main": [[{ "node": "Fetch mandates", "type": "main", "index": 0 }]]
    },
    "Fetch mandates": {
      "main": [[{ "node": "Prepare weekly", "type": "main", "index": 0 }]]
    },
    "Prepare weekly": {
      "main": [[{ "node": "Call community", "type": "main", "index": 0 }]]
    },
    "Call community": {
      "main": [[{ "node": "Format intro", "type": "main", "index": 0 }]]
    },
    "Format intro": {
      "main": [[{ "node": "Send WhatsApp", "type": "main", "index": 0 }]]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "binaryMode": "separate",
    "timezone": "Africa/Lagos"
  },
  "staticData": null,
  "pinData": {},
  "tags": []
}
