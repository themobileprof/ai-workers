# Live copy: /etc/caddy/conf.d/workers.caddy
# Do not overwrite /etc/caddy/Caddyfile — that file only imports conf.d
# (enterprisellm.ng shares this VM).
workers.themobileprof.com {
	encode gzip
	log {
		output file /var/log/caddy/workers.log
		format json
	}

	# Public landing. Must not prefix-match /webhook or /n8n.
	@public path_regexp ^/($|site(/.*)?)$
	handle @public {
		reverse_proxy 127.0.0.1:8000
	}

	# Company desk. /departments and /internal stay off the internet.
	handle /admin* {
		reverse_proxy 127.0.0.1:8000
	}

	# WhatsApp, Telegram, form waits. These public paths must not change.
	@hooks {
		path /webhook* /webhook-test* /webhook-waiting* /form* /mcp* /mcp-test*
	}
	handle @hooks {
		reverse_proxy 127.0.0.1:5678
	}

	# n8n's SPA reads window.location.pathname. /n8n/ therefore 404s even though
	# the HTML 200s. Send the editor to routes n8n already knows (/home, /signin).
	# Do not set N8N_PATH — that would prefix /webhook* and break Meta/Telegram.
	redir /n8n /home 308
	redir /n8n/ /home 308

	# n8n editor + REST. Allowlist only — do not catch-all to :5678.
	@n8nui {
		path /home* /signin* /signup* /signout* /logout* /setup*
		path /forgot-password* /change-password*
		path /rest* /assets* /static* /types* /icons*
		path /oauth2-credential* /sso* /saml*
		path /favicon.ico /icon.svg
	}
	handle @n8nui {
		reverse_proxy 127.0.0.1:5678 {
			flush_interval -1
			header_down -X-Frame-Options
		}
		header Content-Security-Policy "frame-ancestors 'self'"
	}
}
